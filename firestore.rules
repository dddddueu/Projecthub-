rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All: Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProject(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('status' in data) || (data.status in ['planning', 'in_progress', 'completed', 'on_hold']))
        && (!('priority' in data) || (data.priority in ['low', 'medium', 'high', 'urgent']))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Health check endpoint for testing connection
    match /test/{testId} {
      allow read: if true;
    }

    // Projects collection: enforces strict ownership and RLS parity
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(projectId)
        && isValidProject(incoming())
        && incoming().userId == request.auth.uid
        && incoming().keys().hasAll(['userId', 'name', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['userId', 'name', 'description', 'status', 'priority', 'createdAt', 'updatedAt'])
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(projectId)
        && isValidProject(incoming())
        && resource.data.userId == request.auth.uid
        && incoming().userId == resource.data.userId
        && incoming().createdAt == resource.data.createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'status', 'priority', 'updatedAt']);

      allow delete: if isSignedIn()
        && isValidId(projectId)
        && resource.data.userId == request.auth.uid;
    }
  }
}
